# Copy to .env.local. Development Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix with NEXT_PUBLIC_ or commit this secret.
SUPABASE_SECRET_KEY=

APP_ORIGIN=http://localhost:3100

# Rate limit compartido (Upstash Redis). Vercel Marketplace inyecta KV_REST_API_URL y KV_REST_API_TOKEN,
# que también se aceptan. Sin ellas se usa un límite local por proceso (solo desarrollo).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
